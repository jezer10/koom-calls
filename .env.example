# =============================================================================
# koom-calls · variables de entorno del cliente (Vue 3 + Vite)
# =============================================================================
# En desarrollo local, copiar a `.env` y editar.
# En CI/CD, estas se pasan al Dockerfile como --build-arg
# (ver `.github/workflows/docker-publish.yml`).
# =============================================================================
# Estas son las ÚNICAS variables que el front lee (todas pasan por
# `src/config.js` → `APP_CONFIG`). Cualquier otra var definida acá
# será ignorada por Vite, porque solo expone al bundle las que
# empiezan con `VITE_`.
# =============================================================================

# URL del backend NestJS. En dev suele ser http://localhost:8080.
# En prod, la URL pública del API: ej. https://api.example.com
# La URL del socket.io de signaling se deriva de esta: el server socket
# vive en el mismo origen, en el namespace `/signaling` (ver
# `src/api/signaling-client.js`).
VITE_API_BASE_URL=http://localhost:8080

# URL pública del SFU LiveKit (sin esto, el cliente no puede unirse a la sala).
# Formato: wss://livekit.example.com
# VITE_SFU_URL=

# Habilita el botón de "Continuar como invitado" en el front.
# Poner `false` en producción.
VITE_ANONYMOUS_LOGIN_ENABLED=true

# Origin del front-end. Necesario para validar `event.origin` en el
# listener de `postMessage` que recibe la respuesta del popup OAuth.
# Si está vacío, se usa `window.location.origin`.
VITE_FRONTEND_ORIGIN=http://localhost:5173
