# =============================================================================
# koom-calls · variables de entorno para docker compose (front)
# =============================================================================
# Este archivo es la plantilla para correr el front vía docker compose
# compartiendo red con Nginx Proxy Manager.
#
# 1. Copiá este archivo a `.env.docker-compose` (o a `.env`):
#      cp .env.docker-compose.example .env.docker-compose
# 2. Editá los valores para tu entorno.
# 3. Levantá el stack con el script de bootstrap:
#      ./scripts/npm-up.sh
#
# Docker compose busca `.env` por defecto; el script también busca
# `.env.docker-compose`. Si no encuentra ninguno, usa los defaults del
# `docker-compose.yml` (localhost:8080).
# =============================================================================

# -----------------------------------------------------------------------------
# URL del backend (inyectada en el bundle al construir la imagen)
# -----------------------------------------------------------------------------
# ⚠️  El path DEBE terminar en `/api`. El back aplica
# `app.setGlobalPrefix('api', …)` (ver `back/src/main.ts:24`) y todos
# los controllers cuelgan de ahí. Si lo omitís, cada request REST
# devuelve 404.
#
# Variante A — back en el mismo host vía `host.docker.internal:8080`:
#   VITE_API_BASE_URL=http://host.docker.internal:8080/api
#
# Variante B — back en otro VPS / accesible solo por dominio público:
#   VITE_API_BASE_URL=https://api.tudominio.com/api
#   VITE_FRONTEND_ORIGIN=https://koom.tudominio.com
#
# Default (fallback si no hay .env): http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# SFU (LiveKit)
# -----------------------------------------------------------------------------
# VITE_SFU_URL=wss://livekit.tudominio.com
VITE_SFU_URL=

# -----------------------------------------------------------------------------
# Dev auth (login fake para entorno de desarrollo)
# -----------------------------------------------------------------------------
# true  → muestra el form de dev-login en la pantalla home
# false → producción; deshabilita el login dev
VITE_DEV_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# Login anónimo (entrar a una sala sin Google)
# -----------------------------------------------------------------------------
# true  → muestra el botón "Continuar como invitado"
# false → producción
# (No es un build arg del Dockerfile; se usa en runtime.)
# VITE_ANONYMOUS_LOGIN_ENABLED=true
